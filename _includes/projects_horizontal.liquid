<div class="col mb-4">
  <div class="card h-100 hoverable">
    <div class="row no-gutters">
      {% if project.img %}
        <a href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}" class="col-md-4">
          {% include figure.liquid loading="eager" path=project.img sizes="(min-width: 768px) 33vw, 100vw" alt="project thumbnail" class="card-img" %}
        </a>
      {% endif %}
      <div class="{% if project.img %}col-md-8{% else %}col-md-12{% endif %}">
        <div class="card-body">
          <a href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}" class="project-title-link">
            <h3 class="card-title">{{ project.title }}</h3>
          </a>
          <p class="card-text">{{ project.description }}</p>

          {% if project.links or project.github %}
            {% assign link_priority = "Paper,Code,Slides,Video" | split: "," %}
            <div class="project-tags project-tags-links">
              {% for label in link_priority %}
                {% assign matches = project.links | where: "label", label %}
                {% for link in matches %}
                  <a href="{{ link.url }}" class="tag" target="_blank" rel="noopener">
                    {% case link.label %}
                      {% when "Paper" %}<i class="fa-solid fa-file-pdf"></i>
                      {% when "Code" %}<i class="fa-brands fa-github"></i>
                      {% when "Slides" %}<i class="fa-solid fa-file-powerpoint"></i>
                      {% when "Video" %}<i class="fa-solid fa-video"></i>
                      {% else %}<i class="fa-solid fa-link"></i>
                    {% endcase %}
                    {{ link.label }}
                  </a>
                {% endfor %}
              {% endfor %}
              {% if project.links %}
                {% for link in project.links %}
                  {% unless link_priority contains link.label %}
                    {% if link.url %}
                      <a href="{{ link.url }}" class="tag" target="_blank" rel="noopener">
                        <i class="fa-solid fa-link"></i> {{ link.label }}
                      </a>
                    {% else %}
                      <span class="tag tag-static">{{ link.label }}</span>
                    {% endif %}
                  {% endunless %}
                {% endfor %}
              {% endif %}
              {% if project.github %}
                <a href="{{ project.github }}" class="tag" target="_blank" rel="noopener">
                  <i class="fa-brands fa-github"></i> Code
                  {% if project.github_stars %}
                    <span class="stars" data-toggle="tooltip" title="GitHub Stars">
                      <i class="fa-solid fa-star"></i>
                      <span id="{{ project.github_stars }}-stars"></span>
                    </span>
                  {% endif %}
                </a>
              {% endif %}
            </div>
          {% endif %}

          {% if project.tags %}
            <div class="project-tags project-tags-meta">
              {% for t in project.tags %}
                <span class="tag tag-static">{{ t }}</span>
              {% endfor %}
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</div>
